{
	"name": "@invisement/markdown-presentation",
	"version": "1.0.1",
	"nodeModulesDir": "auto",
	"workspace": [
		"./ui",
		"./editor-easymde",
		"./editor-tiptap",
		"./husk"
	],
	"exports": {
		".": "./server.ts"
	},
	"tasks": {
		"dev": "deno task dev:build & deno task dev:server",
		"dev:server": "deno run -A server.ts",
		"dev:build": "deno run -A husk/build.ts --watch",
		"build": "deno run -A husk/build.ts"
	},
	"imports": {
		"@invisement/husk": "./husk/mod.ts",
		"@tiptap/core": "npm:@tiptap/core",
		"@tiptap/starter-kit": "npm:@tiptap/starter-kit",
		"tiptap-markdown": "npm:tiptap-markdown",
		"@tiptap/pm/state": "npm:@tiptap/pm/state",
		"@tiptap/pm/view": "npm:@tiptap/pm/view",
		"@tiptap/pm/model": "npm:@tiptap/pm/model",
		"@tiptap/pm/transform": "npm:@tiptap/pm/transform",
		"prosemirror-state": "npm:prosemirror-state",
		"easymde": "npm:easymde",
		"marked": "npm:marked",
		"marked-gfm-heading-id": "npm:marked-gfm-heading-id",
		"mermaid": "npm:mermaid",
		"graphviz": "npm:@hpcc-js/wasm",
		"node:fs": "jsr:@std/fs",
		"node:path": "jsr:@std/path"
	}
}