digraph logic {
  graph [fontsize=24; rankdir="LR"; labelloc="b"; concentrate=true; overlap=false; splines=true; color=black; nodesep=0.5; ranksep=2;];
  node [shape=box, fontsize=16, color=blue, fontname="Arial", style=filled, fillcolor="#f9f9ff"];
  edge [fontsize=12, color=blue, arrowhead=vee];

  subgraph "cluster_EditorOrchestrator" {
    label = "EditorOrchestrator";
    "editor-orchestrator.ts:EditorOrchestrator:syncPairedMarkers" [label="syncPairedMarkers", URL="editor-orchestrator.ts", tooltip="editor-orchestrator.ts"];
    "editor-orchestrator.ts:EditorOrchestrator:transformBlockStructure" [label="transformBlockStructure", URL="editor-orchestrator.ts", tooltip="editor-orchestrator.ts"];
    "editor-orchestrator.ts:EditorOrchestrator:reparseCollapsedBlock" [label="reparseCollapsedBlock", URL="editor-orchestrator.ts", tooltip="editor-orchestrator.ts"];
    "editor-orchestrator.ts:EditorOrchestrator:unwrapInlineStyle" [label="unwrapInlineStyle", URL="editor-orchestrator.ts", tooltip="editor-orchestrator.ts"];
    "editor-orchestrator.ts:EditorOrchestrator:handleBlockInput" [label="handleBlockInput", URL="editor-orchestrator.ts", tooltip="editor-orchestrator.ts"];
    "editor-orchestrator.ts:EditorOrchestrator:loadSample" [label="loadSample", URL="editor-orchestrator.ts", tooltip="editor-orchestrator.ts"];
  }
  subgraph "cluster_MdCtrl" {
    label = "MdCtrl";
    "dom-servicer.ts:MdCtrl:syncContent" [label="syncContent", URL="dom-servicer.ts", tooltip="dom-servicer.ts"];
  }
  subgraph "cluster_DomServicer" {
    label = "DomServicer";
    "dom-servicer.ts:DomServicer:replaceNode" [label="replaceNode", URL="dom-servicer.ts", tooltip="dom-servicer.ts"];
    "dom-servicer.ts:DomServicer:removeNode" [label="removeNode", URL="dom-servicer.ts", tooltip="dom-servicer.ts"];
    "dom-servicer.ts:DomServicer:unwrapNode" [label="unwrapNode", URL="dom-servicer.ts", tooltip="dom-servicer.ts"];
    "dom-servicer.ts:DomServicer:clearAndAppend" [label="clearAndAppend", URL="dom-servicer.ts", tooltip="dom-servicer.ts"];
    "dom-servicer.ts:DomServicer:onMarkerRemoved" [label="onMarkerRemoved", URL="dom-servicer.ts", tooltip="dom-servicer.ts"];
    "dom-servicer.ts:DomServicer:onMarkerMutation" [label="onMarkerMutation", URL="dom-servicer.ts", tooltip="dom-servicer.ts"];
  }
  subgraph "cluster_MarkdownParser" {
    label = "MarkdownParser";
    "markdown-parser.ts:MarkdownParser:parseInline" [label="parseInline", URL="markdown-parser.ts", tooltip="markdown-parser.ts"];
  }
  subgraph cluster_events {
    label = "Events / PubSub";
    "Topic:markerChanged" [label="markerChanged", URL="pubsub.ts", tooltip="pubsub.ts"];
    "Topic:markerRemoved" [label="markerRemoved", URL="pubsub.ts", tooltip="pubsub.ts"];
  }
  subgraph cluster_browser {
    label = "Browser APIs";
    "Browser:fetch" [label="fetch"];
    "Browser:customElements" [label="customElements"];
    "Browser:document" [label="document"];
    "Browser:MutationObserver" [label="MutationObserver"];
    "Browser:window" [label="window"];
  }
  "Topic:markerChanged" -> "editor-orchestrator.ts:EditorOrchestrator:syncPairedMarkers";
  "Topic:markerChanged" -> "editor-orchestrator.ts:EditorOrchestrator:transformBlockStructure";
  "Topic:markerRemoved" -> "editor-orchestrator.ts:EditorOrchestrator:reparseCollapsedBlock";
  "Topic:markerRemoved" -> "editor-orchestrator.ts:EditorOrchestrator:unwrapInlineStyle";
  "dom-servicer.ts:DomServicer:clearAndAppend" -> "Browser:window";
  "dom-servicer.ts:DomServicer:onMarkerMutation" -> "Topic:markerChanged";
  "dom-servicer.ts:DomServicer:onMarkerRemoved" -> "Browser:MutationObserver";
  "dom-servicer.ts:DomServicer:onMarkerRemoved" -> "Browser:document";
  "dom-servicer.ts:DomServicer:onMarkerRemoved" -> "Topic:markerRemoved";
  "dom-servicer.ts:DomServicer:replaceNode" -> "Browser:window";
  "dom-servicer.ts:MdCtrl:syncContent" -> "Browser:customElements";
  "editor-orchestrator.ts:EditorOrchestrator:handleBlockInput" -> "dom-servicer.ts:DomServicer:replaceNode";
  "editor-orchestrator.ts:EditorOrchestrator:loadSample" -> "Browser:fetch";
  "editor-orchestrator.ts:EditorOrchestrator:loadSample" -> "dom-servicer.ts:DomServicer:clearAndAppend";
  "editor-orchestrator.ts:EditorOrchestrator:reparseCollapsedBlock" -> "dom-servicer.ts:DomServicer:replaceNode";
  "editor-orchestrator.ts:EditorOrchestrator:syncPairedMarkers" -> "dom-servicer.ts:MdCtrl:syncContent";
  "editor-orchestrator.ts:EditorOrchestrator:transformBlockStructure" -> "dom-servicer.ts:DomServicer:replaceNode";
  "editor-orchestrator.ts:EditorOrchestrator:unwrapInlineStyle" -> "dom-servicer.ts:DomServicer:removeNode";
  "editor-orchestrator.ts:EditorOrchestrator:unwrapInlineStyle" -> "dom-servicer.ts:DomServicer:unwrapNode";
  "markdown-parser.ts:MarkdownParser:parseInline" -> "Browser:document";
}
